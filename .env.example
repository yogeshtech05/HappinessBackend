# ==============================================================================
# HAPPINESS DELIVER API - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application
NODE_ENV=development
PORT=4000
API_PREFIX=api
# Comma separated list of allowed origins for CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Database (PostgreSQL / Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/happiness_deliver

# Auth
JWT_SECRET=change_me_super_secret_jwt_key_for_happiness_deliver_2026
JWT_EXPIRES_IN=12h
ADMIN_COOKIE_NAME=hd_admin_session
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Seed super admin
INITIAL_ADMIN_NAME=Vedant Sharma
INITIAL_ADMIN_EMAIL=admin@happinessdeliver.com
INITIAL_ADMIN_PASSWORD=Admin@123456

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=120
